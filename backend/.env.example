# 各項目の説明は docs/backend.md を参照。コピーして .env を作成する（.env はコミットしない）

DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# 未設定なら backend/db.sqlite3 を使う。本番は postgres://user:pass@host:5432/dbname
DATABASE_URL=

# フロントエンドのオリジン（frontend の NEXT_PUBLIC_API_BASE_URL と対になる）
CORS_ALLOWED_ORIGINS=http://localhost:3000
# https で配信する本番では true
REFRESH_COOKIE_SECURE=false

# Google Cloud Console で発行した OAuth クライアントID（frontend の NEXT_PUBLIC_GOOGLE_CLIENT_ID と同じ値）
GOOGLE_OAUTH_CLIENT_ID=

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium
DAILY_TOKEN_LIMIT=300000

# メール（開発ではコンソールに出力される）
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.com
# 要件サマリーの送信先
ADMIN_EMAIL=
